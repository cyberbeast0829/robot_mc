      "name": "system.version",
      "type": "float",
      "access": "r",
      "get": "VERSION_NUM",
      "brief": "固件版本号"
    },
    {
      "name": "system.prefs_sequence",
      "type": "uint32",
      "access": "r",
      "get": "prefs.sequence",
      "brief": "当前配置块的序号"
    },
    {
      "name": "system.config_schema",
      "type": "uint16",
      "access": "r",
      "get": "prefs.schema",
      "brief": "配置记录的格式版本（PREFS_SCHEMA），用于升级迁移"
    },
    {
      "name": "system.prefs_loaded",
      "type": "bool",
      "access": "r",
      "get": "prefs.loaded",
      "brief": "是否从 flash 成功加载过配置"
    },
    {
      "name": "system.save_status",
      "type": "uint8",
      "access": "r",
      "get": "state.save_status",
      "brief": "最近一次写 flash 的结果（save/zero/reset_config）：0 未执行、1 成功、2 因门极使能跳过、3 写失败"
    },
    {
      "name": "system.can_prot_active",
      "type": "int32",
      "access": "r",
      "get": "can_active_prot()",
      "brief": "当前生效的 CAN 协议（0=旧 11-bit，1=CYBERBEAST）",
      "persist": false
    },
    {
      "name": "system.can_fd",
      "type": "bool",
      "access": "r",
      "get": "can_is_fd()",
      "brief": "当前是否以 CAN FD 运行",
      "persist": false
    },
    {
      "name": "system.can_baud_active",
      "type": "int32",
      "access": "r",
      "get": "can_active_baud()",
      "unit": "bit/s",
      "brief": "当前生效的 CAN 速率（Classic 为位速率；FD 为数据域速率）",
      "persist": false
    },
    {
      "name": "action.save",
      "type": "void",
      "access": "w",
      "brief": "把当前配置写入 flash（要求门极关闭）",
      "require": "!controller.gate_drive_enabled",
      "call": "state.save_status = 0; state.save_pending = 1;"
    },
    {
      "name": "action.zero",
      "type": "void",
      "access": "w",
      "brief": "把当前位置设为零点并保存（仅菜单状态）",
      "require": "state.state == MENU_MODE",
      "call": "state.zero_pending = 1;"
    },
    {
      "name": "action.idle_mode",
      "type": "void",
      "access": "w",
      "brief": "空闲/停机：关门极、清锁存故障、回到菜单（退出电机模式、急停用）",
      "call": "request_fsm_state(&state, MENU_MODE);"
    },
    {
      "name": "action.clear_fault",
      "type": "void",
      "access": "w",
      "brief": "清除锁存故障（等价于 action.idle_mode）",
      "call": "request_fsm_state(&state, MENU_MODE);"
    },
    {
      "name": "action.motor_mode",
      "type": "void",
      "access": "w",
      "brief": "进入电机模式（仅菜单状态）",
      "require": "state.state == MENU_MODE",
      "call": "request_fsm_state(&state, MOTOR_MODE);"
    },
    {
      "name": "action.calibrate",
      "type": "void",
      "access": "w",
      "brief": "进入标定（相序/极对数、编码器零位与 LUT、R/L/Ld-Lq/磁链；仅菜单状态）",
      "require": "state.state == MENU_MODE",
      "call": "request_fsm_state(&state, CALIBRATION_MODE);"
    },
    {
      "name": "action.reset_config",
      "type": "void",
      "access": "w",
      "brief": "恢复出厂默认值并写入 flash（要求门极关闭；会清掉标定，需重新标定并重启）",
      "require": "!controller.gate_drive_enabled",
      "call": "state.save_status = 0; state.reset_config_pending = 1;"
    },
    {
      "name": "action.reboot",
      "type": "void",
      "access": "w",
      "brief": "重启控制器（应答发出后约 0.5 s 复位，配置按已保存的值重新加载）",
      "call": "state.reboot_pending = 1;"
    },
    {
      "name": "action.reset_timing",
      "type": "void",
      "access": "w",
      "brief": "清零 ISR 耗时统计",
      "call": "isr_timing.reset_req = 1;"
    },
    {
      "name": "internal.encoder_lut",
      "type": "blob",
      "hidden": true,
      "persist": true,
      "ref": "ENCODER_LUT",
      "size": 512,
      "assert": "N_LUT * sizeof(int) == 512",
      "brief": "编码器查找表（128 × int32），标定后写入，持久化但不对外暴露"
    }
  ]
}
